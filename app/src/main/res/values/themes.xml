<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme only; the UI itself is themed in Compose (InkNotesTheme). The window
         background is the paper, not the system's dark default, so nothing flashes black. -->
    <style name="Theme.InkNotes" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/splash_bg</item>
    </style>

    <!-- The main window at launch: the logo is there from the first moment. -->
    <style name="Theme.InkNotes.Launch">
        <item name="android:windowBackground">@drawable/splash_window</item>
    </style>
</resources>
