<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="widget_quick_note">✎ Quick note</string>
    <string name="widget_empty">Your recent notebooks will appear here</string>
    <string name="widget_description">Quick note and recent notebooks</string>
    <string name="tile_quick_note">Note</string>

    <style name="WidgetRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:background">@drawable/widget_row</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">#FF1B1B1F</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
